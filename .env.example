# Algorithmic Trading Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive information

# ==========================================
# Application Settings
# ==========================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==========================================
# Alpaca Trading API Configuration
# ==========================================
# Get your API keys from: https://app.alpaca.markets/paper/dashboard/overview

# Paper Trading (default)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live Trading (uncomment when ready for live trading)
# ALPACA_API_KEY=your_live_api_key_here
# ALPACA_SECRET_KEY=your_live_secret_key_here
# ALPACA_BASE_URL=https://api.alpaca.markets

# ==========================================
# Alpaca Market Data Configuration
# ==========================================
# Data feed: 'iex' (free) or 'sip' (paid, real-time)
ALPACA_DATA_FEED=iex

# Optional: Separate data API keys (if different from trading keys)
# ALPACA_DATA_KEY=your_data_key_here
# ALPACA_DATA_SECRET=your_data_secret_here

# ==========================================
# Database Configuration
# ==========================================
# SQLite (development)
DATABASE_URL=sqlite:///./data/trading.db

# PostgreSQL (production - uncomment when ready)
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_db

# ==========================================
# API Server Settings
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API rate limiting
API_RATE_LIMIT=60  # requests per minute

# ==========================================
# Ollama AI Configuration
# ==========================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# AI response timeout (seconds)
OLLAMA_TIMEOUT=30

# Enable/disable AI features
ENABLE_AI=true

# ==========================================
# Frontend Configuration
# ==========================================
# URL for API calls from frontend
VITE_API_URL=http://localhost:8000

# TradingView library path (if using)
VITE_TRADINGVIEW_PATH=/charting_library/

# ==========================================
# Market Data Settings
# ==========================================
# Maximum concurrent market data subscriptions
MAX_DATA_SUBSCRIPTIONS=50

# Data refresh rate (milliseconds)
DATA_REFRESH_RATE=1000

# Historical data cache duration (hours)
HIST_DATA_CACHE=24

# ==========================================
# Strategy Configuration
# ==========================================
# Default risk per trade (% of account)
DEFAULT_RISK_PERCENT=1.0

# Maximum position size (% of account)
MAX_POSITION_SIZE=10.0

# Enable/disable strategy execution
ENABLE_TRADING=false

# Maximum number of concurrent positions
MAX_POSITIONS=5

# ==========================================
# Logging Configuration
# ==========================================
# Log file location
LOG_FILE=logs/trading.log

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Separate log levels for components
LOG_LEVEL_IBKR=INFO
LOG_LEVEL_STRATEGIES=DEBUG
LOG_LEVEL_API=INFO

# ==========================================
# Redis Configuration (Optional - Future)
# ==========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ==========================================
# Email Notifications (Optional - Future)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=trading-bot@yourdomain.com
# EMAIL_TO=your-email@gmail.com

# ==========================================
# Monitoring & Alerts (Optional - Future)
# ==========================================
# ENABLE_ALERTS=false
# ALERT_ON_ERROR=true
# ALERT_ON_TRADE=false
# ALERT_ON_SIGNAL=false

# ==========================================
# Backup & Data Export
# ==========================================
# Backup directory
BACKUP_DIR=backups/

# Auto-backup interval (hours)
BACKUP_INTERVAL=24

# ==========================================
# Development Tools
# ==========================================
# Enable debug toolbar
ENABLE_DEBUG_TOOLBAR=true

# Enable SQL query logging
LOG_SQL_QUERIES=false

# Enable profiling
ENABLE_PROFILING=false

# ==========================================
# Security (Production Only)
# ==========================================
# JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION=3600

# API key for external services
# API_KEY=your-api-key-here

# ==========================================
# Testing Configuration
# ==========================================
# Use separate test database
TEST_DATABASE_URL=sqlite:///./data/test_trading.db

# Disable external API calls in tests
TESTING=false

# ==========================================
# Feature Flags
# ==========================================
# Enable/disable features during development
FEATURE_MARKET_SCANNER=true
FEATURE_BACKTESTING=true
FEATURE_AI_RESEARCH=true
FEATURE_ALERTS=false
FEATURE_PORTFOLIO_TRACKING=true

# ==========================================
# Performance Settings
# ==========================================
# Worker threads for async operations
WORKER_THREADS=4

# Database connection pool size
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ==========================================
# Notes for Setup
# ==========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your IBKR account details
# 3. Verify Ollama is running: curl http://localhost:11434/api/tags
# 4. Create data directory: mkdir -p data
# 5. Create logs directory: mkdir -p logs
# 6. Never commit .env to git!
#
# For more information, see:
# - README.md for setup instructions
# - memory-bank/techContext.md for technical details
# - .masterplan.md for development roadmap
